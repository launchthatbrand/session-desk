FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/SessionDesk.Api/SessionDesk.Api.csproj src/SessionDesk.Api/
RUN dotnet restore src/SessionDesk.Api/SessionDesk.Api.csproj
COPY src/SessionDesk.Api/ src/SessionDesk.Api/
RUN dotnet publish src/SessionDesk.Api/SessionDesk.Api.csproj -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
ENTRYPOINT ["dotnet", "SessionDesk.Api.dll"]
